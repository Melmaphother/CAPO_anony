# Copy this file to .env and adjust values for the local environment.

# In-process vLLM policy.
PAPER_SEARCH_INFERENCE_MODEL_PATH=Qwen/Qwen3-4B-Instruct-2507
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.8
VLLM_MAX_MODEL_LEN=10240
PAPER_SEARCH_INFERENCE_MAX_NEW_TOKENS=4096
PAPER_SEARCH_INFERENCE_TEMPERATURE=0.0
PAPER_SEARCH_TOOL_PARSER=hermes

# Paper retrieval service.
PAPER_SEARCH_BASE_URL=http://127.0.0.1:4000
PAPER_AGENT_V2_SEARCH_SOURCE=internal
PAPER_AGENT_V2_PAPER_FROM=
PAPER_AGENT_V2_PAPER_TO=

# Selector service.
PAPERSEARCH_SELECTOR_BASE_URL=http://127.0.0.1:8000
PAPERSEARCH_SELECTOR_MODEL_NAME=selector

# Batch input and output.
PAPER_AGENT_V2_DATASET=recipe/paper_search/inference/datasets/AutoScholarQuery/test.jsonl
PAPER_AGENT_V2_SAVE_DIR=outputs/paper_search_inference
PAPER_AGENT_V2_RETRY_ROUNDS=3
PAPER_SEARCH_INFERENCE_MAX_STEPS=5
